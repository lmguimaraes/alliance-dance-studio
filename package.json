{
  "name": "alliance-dance-studio",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm db:migrate:alpha && pnpm dev:app",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "pnpm db:migrate:alpha && pnpm start:app",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:booking": "vitest run server/bookingPolicy.test.ts server/rateLimit.test.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx seed-db.ts",
    "db:migrate:alpha": "node scripts/run-database-migrations.mjs",
    "alpha:doctor": "node scripts/alpha-doctor.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "dev:app": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "start:app": "cross-env NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "i18next": "^25.7.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "jose": "6.1.0",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.5",
    "postgres": "^3.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.4.0",
    "sonner": "^2.0.7",
    "stripe": "^21.0.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.3.5",
    "zod": "^3.23.8",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4",
    "@types/pg": "^8.11.10"
  },
  "packageManager": "pnpm@10.4.1"
}
