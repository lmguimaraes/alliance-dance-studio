# Copy to .env for local development. Never commit real values.

# Public origin of the site, used for Stripe return URLs. HTTPS in production.
APP_URL=http://localhost:3000
PORT=3000

# PostgreSQL (Supabase) connection string. Use the pooler URL in production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/alliance
# Set to false only for a local database without TLS.
DATABASE_SSL=true

# Admin panel password. Falls back to 0000 when empty: set a strong one before launch.
ADMIN_PASSWORD=
# Signs admin sessions. Required in production: at least 32 random characters.
JWT_SECRET=

# Stripe (studio rentals). Keep test keys until launch.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=cad
# Refuses live keys while true. Set to false deliberately at launch.
STRIPE_TEST_MODE_ONLY=true

# Number of trusted reverse proxies in front of the app (for client IPs).
TRUST_PROXY_HOPS=0

# Instagram feed in Discover > Gallery (optional).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=alliancedancecompany
# Up to three post IDs to show first. List them with: pnpm instagram:media
INSTAGRAM_PINNED_MEDIA_IDS=
