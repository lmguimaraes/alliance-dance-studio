# Application
NODE_ENV=development
PORT=3000
# Set to 1 only when exactly one trusted reverse proxy sits in front of Express.
TRUST_PROXY_HOPS=0
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/alliance_dance
DATABASE_SSL=false

# Existing authentication integration
JWT_SECRET=replace-with-a-long-random-value
VITE_APP_ID=
OAUTH_SERVER_URL=
OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Stripe Checkout
# Keep secret keys server-side. Never prefix these variables with VITE_.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=cad
# Safety guard for development and acceptance testing.
STRIPE_TEST_MODE_ONLY=true
